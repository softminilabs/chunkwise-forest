 ],
 "openTask": {
  "prompt": "用被动语态写 3 句话，说说你们团队最近的一个项目：一句说过去发生的，一句用 must / should / can，一句说将来。",
  "rules": [
   "被动 = be + 过去分词，be 跟着时间变",
   "情态动词后面用 be 原形 + 过去分词"
  ],
  "note": "规则判 be + 过去分词的形式（计分）；离线模型给更自然的说法（AI 建议，不计分）"
 }
}
