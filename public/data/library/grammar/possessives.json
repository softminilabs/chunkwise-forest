{
 "id": "g-possessives",
 "title": "所有格",
 "en": "Possessives",
 "group": "名词和代词",
 "level": "A2",
 "order": 41,
 "keywords": [
  "所有格"
 ],
 "related": [
  "g-pronouns",
  "g-articles",
  "g-countable"
 ],
 "markup": {
  "[[x]]": "重点形式：这个语法要你注意的词（橙底）",
  "{x}": "变化的部分：只用在 [[ ]] 里，例如 work{s}（橙底里加粗下划线）",
  "((x))": "变回原形的动词（虚线下划线）",
  "<<x>>": "信号词（圆角框）",
  "~~x~~": "错句里错的部分（删除线）"
 },
 "sections": {
  "idea": {
   "title": "一句话说清",
   "short": "说清",
   "text": "所有格就是中文的「**的**」。人和动物的东西，多用 **'s**：Tom's laptop；东西的某一部分，多用 **of**：the end of the meeting。",
   "uses": [
    {
     "zh": "人的东西：名字加 's",
     "en": "This is [[Tom{'s}]] laptop.",
     "en_zh": "这是 Tom 的电脑。"
    },
    {
     "zh": "好几个人的东西：s 后面只加 '",
     "en": "The [[users{'}]] feedback was mixed.",
     "en_zh": "用户们的反馈褒贬不一。"
    },
    {
     "zh": "东西的一部分：用 of，顺序和中文反过来",
     "en": "Let's talk at [[the end of]] the meeting.",
     "en_zh": "我们会议结束时再聊。"
    }
   ]
  },
  "apostrophe": {
   "title": "'s 怎么加",
   "short": "怎么加",
   "rule": "一个人加 's；s 结尾的复数只加 '；不是 s 结尾的复数（people、children）还是加 's。",
   "rules": [
    {
     "ending": "一个人、单数名词",
     "change": "加 's",
     "examples": [
      "Tom → [[Tom{'s}]]",
      "my boss → my [[boss{'s}]]"
     ]
    },
    {
     "ending": "s 结尾的复数",
     "change": "只加 '",
     "examples": [
      "users → the [[users{'}]]",
      "parents → my [[parents{'}]]"
     ]
    },
    {
     "ending": "不是 s 结尾的复数",
     "change": "加 's",
     "examples": [
      "children → [[children{'s}]]",
      "people → [[people{'s}]]"
     ]
    },
    {
     "ending": "两个人一起的",
     "change": "只在最后一个人加 's",
     "examples": [
      "[[Tom and Anna{'s}]] flat"
     ]
    }
   ],
   "examples": [
    {
     "en": "My [[boss{'s}]] office is on the third floor.",
     "zh": "我老板的办公室在三楼。"
    },
    {
     "en": "I'm staying at my [[parents{'}]] this week.",
     "zh": "这周我住在我爸妈家。"
    },
    {
     "en": "[[Tom and Anna{'s}]] flat is near the station.",
     "zh": "Tom 和 Anna 的公寓在车站附近。"
    }
   ],
   "sound": [
    {
     "say": "/s/",
     "when": "在 p、t、k、f 这类不震动喉咙的音后面",
     "examples": [
      "[[Mike{'s}]]",
      "[[Pat{'s}]]"
     ]
    },
    {
     "say": "/z/",
     "when": "在震动喉咙的音和元音后面",
     "examples": [
      "[[Tom{'s}]]",
      "[[Anna{'s}]]"
     ]
    },
    {
     "say": "/ɪz/",
     "when": "在 s、z、sh、ch 这类「嘶嘶」的音后面",
     "examples": [
      "[[boss{'s}]]",
      "[[James{'s}]]"
     ]
    }
   ],
   "oddSounds": "只加 ' 的复数（users'）不多读音，和 users 读起来一模一样。"
  },
  "of": {
   "title": "什么时候用 of",
   "short": "用 of",
   "rule": "说**东西的一部分、东西的名字或特点**，一般用 of。顺序和中文反过来：「会议的结尾」= the end **of** the meeting。",
   "examples": [
    {
     "en": "What's [[the name of]] the file?",
     "zh": "那个文件叫什么名字？"
    },
    {
     "en": "The button is at [[the top of]] the screen.",
     "zh": "按钮在屏幕顶部。"
    },
    {
     "en": "I'll send it by [[the end of]] the day.",
     "zh": "我今天下班前发给你。"
    }
   ],
   "notes": [
    "公司、团队这种「一群人」两种都行：[[the team{'s}]] plan = the plan [[of the team]]，口语里 's 更常用。"
   ]
  },
  "time-place": {
   "title": "时间和地方的 's",
   "short": "时间",
   "rule": "说「今天的、下周的」或者「两周的」，也用 's。说**某人家、某家店**时，后面的「家」「店」常常省掉不说。",
   "items": [
    {
     "rule": "今天的、下周的",
     "en": "Did you go to [[today{'s}]] stand-up?",
     "zh": "你去今天的站会了吗？"
    },
    {
     "rule": "一段时间：两周的假",
     "en": "I'm taking [[two weeks{'}]] holiday.",
     "zh": "我要休两周的假。"
    },
    {
     "rule": "某人家，home 省掉",
     "en": "We had dinner at [[Anna{'s}]].",
     "zh": "我们在 Anna 家吃的晚饭。"
    },
    {
     "rule": "某家店，shop 省掉",
     "en": "I'm going to [[the chemist{'s}]].",
     "zh": "我去趟药店。"
    }
   ]
  },
  "whose": {
   "title": "问「谁的」",
   "short": "谁的",
   "rule": "问「谁的」用 whose。别和 who's 搞混：**who's 就是 who is**，读音一样，意思完全不同。",
   "examples": [
    {
     "en": "[[Whose]] laptop is this?",
     "zh": "这是谁的电脑？",
     "answer": "It's [[Leo{'s}]]."
    },
    {
     "en": "[[Whose]] turn is it to review the code?",
     "zh": "轮到谁看代码了？",
     "answer": "It's [[mine]], I think."
    }
   ],
   "wrong": {
    "bad": "~~Who's~~ phone is ringing?",
    "good": "[[Whose]] phone is ringing?"
   }
  },
  "contrast": {
   "title": "比一比，最常见的错",
   "short": "比一比",
   "pairs": [
    {
     "with": "复数的 s",
     "this": {
      "meaning": "'s：某人的东西",
      "en": "The [[developer{'s}]] laptop is new."
     },
     "that": {
      "meaning": "s：好几个",
      "en": "The [[developer{s}]] are new."
     }
    },
    {
     "with": "it's",
     "this": {
      "meaning": "its：它的（没有撇号）",
      "en": "The app has [[its]] own settings."
     },
     "that": {
      "meaning": "it's：就是 it is",
      "en": "[[It's]] a great app."
     }
    }
   ],
   "commonMistakes": [
    {
     "bad": "This is ~~the laptop of Tom~~.",
     "good": "This is [[Tom{'s}]] laptop.",
     "why": "人的东西用 's，不用 of。"
    },
    {
     "bad": "The ~~users's~~ feedback was good.",
     "good": "The [[users{'}]] feedback was good.",
     "why": "s 结尾的复数只加 '。"
    },
    {
     "bad": "~~Who's~~ bag is this?",
     "good": "[[Whose]] bag is this?",
     "why": "问「谁的」用 whose，who's 是 who is。"
    },
    {
     "bad": "The app updated ~~it's~~ icon.",
     "good": "The app updated [[its]] icon.",
     "why": "「它的」是 its，没有撇号。"
    },
    {
     "bad": "Two ~~developer's~~ joined today.",
     "good": "Two [[developer{s}]] joined today.",
     "why": "只是「好几个」，不是「谁的」，不加撇号。"
    }
   ]
  }
 },
