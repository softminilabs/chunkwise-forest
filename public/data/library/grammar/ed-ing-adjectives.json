{
 "id": "g-ed-ing-adjectives",
 "title": "-ed 和 -ing 形容词",
 "en": "-ed and -ing Adjectives",
 "group": "形容词、副词和介词",
 "level": "B1",
 "order": 45,
 "keywords": [
  "-ed 和 -ing"
 ],
 "related": [
  "g-comparatives",
  "g-linking-verbs",
  "g-adverb-position"
 ],
 "markup": {
  "[[x]]": "重点形式：这个语法要你注意的词（橙底）",
  "{x}": "变化的部分：只用在 [[ ]] 里，例如 work{s}（橙底里加粗下划线）",
  "((x))": "变回原形的动词（虚线下划线）",
  "<<x>>": "信号词（圆角框）",
  "~~x~~": "错句里错的部分（删除线）"
 },
 "sections": {
  "idea": {
   "title": "一句话说清",
   "short": "说清",
   "text": "-ing 说的是**东西本身怎么样**，它让人有某种感觉；-ed 说的是**人心里的感受**。口诀：**ing 是原因，ed 是感受。**",
   "uses": [
    {
     "zh": "-ing：会议让人觉得无聊",
     "en": "The meeting was [[bor{ing}]].",
     "en_zh": "那个会很无聊。"
    },
    {
     "zh": "-ed：我心里觉得无聊",
     "en": "I was [[bor{ed}]] in the meeting.",
     "en_zh": "我开会时觉得很无聊。"
    },
    {
     "zh": "-ing：这个 bug 让人烦",
     "en": "This bug is really [[annoy{ing}]].",
     "en_zh": "这个 bug 真烦人。"
    }
   ]
  },
  "ing": {
   "title": "-ing：它让人觉得……",
   "short": "-ing",
   "rule": "-ing 形容的是**带来感觉的那个东西**：电影、会议、消息、工作。可以问自己：是它让人这样觉得吗？是，就用 -ing。",
   "examples": [
    {
     "en": "The talk was really [[interest{ing}]].",
     "zh": "那个演讲很有意思。"
    },
    {
     "en": "Waiting for the build is so [[frustrat{ing}]].",
     "zh": "等构建等得真让人抓狂。"
    },
    {
     "en": "The news about the outage was [[shock{ing}]].",
     "zh": "服务器宕机的消息让人震惊。"
    }
   ]
  },
  "ed": {
   "title": "-ed：人觉得……",
   "short": "-ed",
   "rule": "-ed 形容的是**心里有感觉的人**。句子的主语一般是 I、she、the team 这样的人。",
   "examples": [
    {
     "en": "I'm [[interest{ed}]] in AI.",
     "zh": "我对 AI 感兴趣。"
    },
    {
     "en": "She felt [[relax{ed}]] after the holiday.",
     "zh": "度完假她觉得很放松。"
    },
    {
     "en": "We were [[surpris{ed}]] by the results.",
     "zh": "结果让我们很意外。"
    }
   ],
   "notes": [
    "-ed 后面常跟固定的小词：interested **in** · bored **with** · worried **about** · excited **about** · tired **of** · surprised **by**"
   ]
  },
  "people": {
   "title": "说人的时候要小心",
   "short": "说人",
   "rule": "人也能用 -ing，但意思变了：**He's boring 是「他这个人很无聊，别人不爱听他说话」**。说自己的感受，千万别用 -ing。",
   "items": [
    {
     "rule": "他心里觉得无聊",
     "en": "He's [[bor{ed}]].",
     "zh": "他觉得没意思。"
    },
    {
     "rule": "他这个人很无趣",
     "en": "He's [[bor{ing}]].",
     "zh": "他这人挺无聊的。"
    },
    {
     "rule": "我被搞糊涂了",
     "en": "I'm [[confus{ed}]].",
     "zh": "我糊涂了。"
    },
    {
     "rule": "我讲得让人糊涂",
     "en": "Sorry, I'm being [[confus{ing}]].",
     "zh": "抱歉，我讲得有点乱。"
    }
   ]
  },
  "list": {
   "title": "常见的一对对",
   "short": "常见词",
   "rule": "下面每一对：左边说人的感受，右边说让人有这种感受的东西。",
   "rules": [
    {
     "ending": "无聊",
     "change": "bored / boring",
     "examples": [
      "I'm [[bor{ed}]].",
      "It's [[bor{ing}]]."
     ]
    },
    {
     "ending": "累",
     "change": "tired / tiring",
     "examples": [
      "I'm [[tir{ed}]].",
      "It's [[tir{ing}]]."
     ]
    },
    {
     "ending": "感兴趣",
     "change": "interested / interesting",
     "examples": [
      "I'm [[interest{ed}]].",
      "It's [[interest{ing}]]."
     ]
    },
    {
     "ending": "兴奋",
     "change": "excited / exciting",
     "examples": [
      "I'm [[excit{ed}]].",
      "It's [[excit{ing}]]."
     ]
    },
    {
     "ending": "担心",
     "change": "worried / worrying",
     "examples": [
      "I'm [[worr{ied}]].",
      "It's [[worry{ing}]]."
     ]
    },
    {
     "ending": "烦",
     "change": "annoyed / annoying",
     "examples": [
      "I'm [[annoy{ed}]].",
      "It's [[annoy{ing}]]."
     ]
    },
    {
     "ending": "失望",
     "change": "disappointed / disappointing",
     "examples": [
      "I'm [[disappoint{ed}]].",
      "It's [[disappoint{ing}]]."
     ]
    },
    {
     "ending": "尴尬",
     "change": "embarrassed / embarrassing",
     "examples": [
      "I'm [[embarrass{ed}]].",
      "It's [[embarrass{ing}]]."
     ]
    }
   ]
  },
  "sound": {
   "title": "-ed 怎么读",
   "short": "读音",
   "rule": "-ed 有三种读法。只有在 t、d 后面，才多读出一个 /ɪd/，别的时候 -ed 都不多出一个音。",
   "sound": [
    {
     "say": "/t/",
     "when": "在 k、s、sh、ch、p 这类不震动喉咙的音后面",
     "examples": [
      "[[relax{ed}]]",
      "[[shock{ed}]]"
     ]
    },
    {
     "say": "/d/",
     "when": "在震动喉咙的音和元音后面",
     "examples": [
      "[[bor{ed}]]",
      "[[annoy{ed}]]",
      "[[worr{ied}]]"
     ]
    },
    {
     "say": "/ɪd/",
     "when": "在 t、d 后面，多读一个音",
     "examples": [
      "[[interest{ed}]]",
      "[[excit{ed}]]",
      "[[disappoint{ed}]]"
     ]
    }
   ],
   "oddSounds": "tired 读 /ˈtaɪəd/，-ed 只读 /d/，不读成 tir-ed /ˈtaɪrɪd/。"
  },
  "contrast": {
   "title": "比一比，最常见的错",
   "short": "比一比",
   "pairs": [
    {
     "with": "-ed",
     "this": {
      "meaning": "-ing：它让人……",
      "en": "The demo was [[excit{ing}]]."
     },
     "that": {
      "meaning": "-ed：人觉得……",
      "en": "Everyone was [[excit{ed}]] about the demo."
     }
    },
    {
     "with": "worried",
     "this": {
      "meaning": "worrying：让人担心的事",
      "en": "The crash numbers are [[worry{ing}]]."
     },
     "that": {
      "meaning": "worried：担心的人",
      "en": "The team is [[worr{ied}]] about the crash numbers."
     }
    }
   ],
   "commonMistakes": [
    {
     "bad": "I'm so ~~boring~~ today. There's nothing to do.",
     "good": "I'm so [[bor{ed}]] today. There's nothing to do.",
     "why": "说自己的感受用 -ed。I'm boring 是「我这人很无聊」。"
    },
    {
     "bad": "The film was ~~bored~~.",
     "good": "The film was [[bor{ing}]].",
     "why": "电影让人无聊，用 -ing。"
    },
    {
     "bad": "I'm ~~interesting~~ in iOS.",
     "good": "I'm [[interest{ed}]] in iOS.",
     "why": "我感兴趣，用 -ed。"
    },
    {
     "bad": "She was ~~exciting~~ about the trip.",
     "good": "She was [[excit{ed}]] about the trip.",
     "why": "她心里兴奋，用 -ed。"
    },
    {
     "bad": "I'm interested ~~about~~ AI.",
     "good": "I'm interested [[in]] AI.",
     "why": "interested 后面固定用 in。"
    }
   ]
  }
 },
