 "openTask": {
  "prompt": "说说你最近的一次会议、一次出行或一部剧，用 3 句话：至少一句用 -ing 说那件事怎么样，一句用 -ed 说你自己的感受。",
  "rules": [
   "-ing 形容引起感受的事物",
   "-ed 形容有感受的人",
   "interested in / worried about / excited about 等介词搭配要对"
  ],
  "note": "规则判 -ed / -ing 选用和介词搭配（计分）；离线模型给更自然的说法（AI 建议，不计分）"
 }
