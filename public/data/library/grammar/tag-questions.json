 "openTask": {
  "prompt": "写 3 个带尾巴的句子，向同事确认今天的安排：一句前面肯定，一句前面否定，一句用普通动词（要借 do / does / did）。",
  "rules": [
   "前肯后否，前否后肯",
   "尾巴里的主语用代词，普通动词借 do / does / did"
  ],
  "note": "规则判尾巴的肯否和助动词（计分）；离线模型给更自然的说法（AI 建议，不计分）"
 }
}
