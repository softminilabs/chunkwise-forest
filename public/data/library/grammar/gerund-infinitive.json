   "type": "fill",
   "prompt": "She promised ___ (send) the designs today.",
   "answer": "to send",
   "accept": [],
   "explain": "promise 后面跟 to do：[[to send]]。"
  },
  {
   "id": "q06",
   "section": "todo",
   "type": "fix",
   "prompt": "改错：I want going home early today.",
   "answer": "I want to go home early today.",
   "accept": [],
   "explain": "want 后面跟 to do：[[to go]]。"
  },
  {
   "id": "q07",
   "section": "both",
   "type": "choice",
   "prompt": "Which sentence is wrong?",
   "options": [
    "It started raining.",
    "It started to rain.",
