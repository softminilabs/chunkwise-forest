  },
  {
   "id": "q03",
   "section": "doing",
   "type": "fill",
   "prompt": "The app keeps ___ (crash) on iPad.",
   "answer": "crashing",
   "accept": [],
   "explain": "keep 后面跟 doing：[[crash{ing}]]。"
  },
  {
   "id": "q04",
   "section": "doing",
   "type": "choice",
   "prompt": "I suggest ___ until Monday.",
   "options": [
    "waiting",
