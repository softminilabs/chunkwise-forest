   "prompt": "改错：Thanks for help me with the release.",
   "answer": "Thanks for helping me with the release.",
   "accept": [
    "Thank you for helping me with the release."
   ],
   "explain": "介词 for 后面跟 doing：[[help{ing}]]。"
  },
  {
   "id": "q17",
   "section": "mistakes",
   "type": "translate",
   "prompt": "翻译：我习惯加班了。",
   "answer": "I'm used to working late.",
   "accept": [
    "I am used to working late.",
    "I'm used to working overtime.",
    "I am used to working overtime."
   ],
   "traps": [
    {
     "input": "I'm used to work late.",
     "note": "be used to 的 to 是介词，后面跟 doing。"
    }
   ],
   "explain": "be used to 后面跟 doing：[[work{ing}]]。"
  }
 ],
 "openTask": {
  "prompt": "写 3 句话说说你的工作：一句用 enjoy / avoid + doing，一句用 want / plan / hope + to do，一句用 look forward to + doing 说你期待的事。",
  "rules": [
   "enjoy / finish / avoid / keep / suggest / mind 后面用 doing",
   "want / need / decide / plan / hope / promise 后面用 to do；介词和 look forward to 后面用 doing"
  ],
  "note": "规则判 doing / to do 有没有搭配对（计分）；离线模型给更自然的说法（AI 建议，不计分）"
 }
}
