  "special": {
   "title": "特殊情况", "short": "特殊",
   "items": [
    {
     "rule": "时刻表、日程表说的是将来，也用一般现在时。",
     "en": "The train [[leave{s}]] at 8:30 <<tomorrow>>.",
     "zh": "火车明天 8:30 开。"
    },
    {
     "rule": "when、if、as soon as 后面说将来的事，用一般现在时，不用 will。",
     "en": "<<When>> she [[arrive{s}]], I'll call you.",
     "zh": "她一到我就给你打电话。"
    },
    {
     "rule": "表示「知道、喜欢、想要、需要」这类状态的动词，一般不用进行时。",
     "en": "I [[know]] the answer.",
     "zh": "我知道答案。（不说 I'm knowing）"
    },
    {
     "rule": "have 的「他她它」形式是 has，不是 haves。",
     "en": "She [[has]] two kids.",
     "zh": "她有两个孩子。"
    }
   ]
  },
  "spelling": {
   "title": "什么时候加 s，什么时候加 es", "short": "加 s",
   "rules": [
    {
     "ending": "大多数动词",
     "change": "加 s",
     "examples": [
      "work → [[work{s}]]",
      "play → [[play{s}]]"
     ]
    },
    {
     "ending": "s、x、sh、ch、o 结尾",
     "change": "加 es",
     "examples": [
      "watch → [[watch{es}]]",
      "fix → [[fix{es}]]",
      "go → [[go{es}]]"
     ]
    },
    {
     "ending": "辅音字母 + y 结尾",
     "change": "去 y，加 ies",
     "examples": [
      "stud~~y~~ → [[stud{ies}]]",
      "tr~~y~~ → [[tr{ies}]]"
     ]
    },
    {
     "ending": "元音字母 + y 结尾",
     "change": "直接加 s",
     "examples": [
      "play → [[play{s}]]",
      "say → [[say{s}]]"
     ]
    },
    {
     "ending": "不规则",
     "change": "要单独记",
     "examples": [
      "have → [[has]]",
      "be → [[is]]",
      "do → [[does]]"
     ]
    }
   ],
   "sound": [
    {
     "say": "/s/",
     "when": "在 p、t、k、f 这类不震动喉咙的音后面",
     "examples": [
      "[[work{s}]]",
      "[[stop{s}]]"
     ]
    },
    {
     "say": "/z/",
     "when": "在震动喉咙的音和元音后面",
     "examples": [
      "[[play{s}]]",
      "[[live{s}]]"
     ]
    },
    {
     "say": "/ɪz/",
     "when": "在 s、z、sh、ch、ge 这类「嘶嘶」的音后面",
     "examples": [
      "[[watch{es}]]",
      "[[fix{es}]]",
      "[[us{es}]]"
     ]
    }
   ],
   "oddSounds": "两个读音特别的：says 读 /sez/，does 读 /dʌz/。"
  },
