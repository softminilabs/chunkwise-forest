 "openTask": {
  "prompt": "用一般现在时说 3 句话，介绍你平常的一个工作日。至少有一句的主语是你的同事或家人（他 / 她）。",
  "rules": [
   "主语是 he / she / 单数名词时，谓语动词必须是三单形式",
   "否定和疑问用 doesn't / does + 原形"
  ],
  "note": "规则判三单和 do / does 用法（计分）；离线模型给更自然的说法（AI 建议，不计分）"
 }
