  "<<x>>": "信号词（圆角框）",
  "~~x~~": "错句里错的部分（删除线）"
 },
 "sections": {
  "idea": {
   "title": "一句话说清", "short": "说清",
   "text": "一般现在时说的是**「平常就这样」**的事：经常做的事、一直都对的事、现在的状态。记住：不是「正在做」，是「平常、一直、本来就」。",
   "uses": [
    {
     "zh": "经常做的事、习惯",
     "en": "I [[drink]] coffee <<every morning>>.",
     "en_zh": "我每天早上都喝咖啡。"
    },
    {
     "zh": "一直都对的事实",
     "en": "Water [[boil{s}]] at 100 degrees.",
     "en_zh": "水在 100 度时沸腾。"
    },
    {
     "zh": "现在的状态",
     "en": "She [[live{s}]] in Shanghai.",
     "en_zh": "她住在上海。"
    }
   ],
   "signals": [
    "always",
    "usually",
    "often",
    "sometimes",
    "never",
    "every day",
    "on Mondays"
   ]
  },
  "positive": {
   "title": "肯定句", "short": "肯定",
   "formula": [
    "主语",
    "动词原形 / 动词 + s",
    "其他"
   ],
   "rule": "主语是「他、她、它」或者一个人、一件东西时，动词后面加 s 或 es。口诀：**他她它，加个 s。**",
   "examples": [
    {
     "en": "I [[work]] from home <<on Fridays>>.",
     "zh": "我每周五在家办公。"
    },
    {
     "en": "She [[work{s}]] at a bank.",
     "zh": "她在银行工作。"
    },
    {
     "en": "Our app [[crash{es}]] on old phones.",
     "zh": "我们的 App 在旧手机上会崩溃。"
    }
   ],
   "be": "be 动词跟着主语变：I [[am]] · he / she / it [[is]] · you / we / they [[are]]"
  },
  "negative": {
   "title": "否定句", "short": "否定",
   "formula": [
    "主语",
    "don't / doesn't",
    "动词原形",
    "其他"
   ],
   "rule": "「他她它」用 doesn't，其他用 don't。**s 只能出现一次**：doesn't 已经带了 s，后面的动词要变回原形。",
   "examples": [
    {
     "en": "I [[don't]] ((drink)) tea.",
     "zh": "我不喝茶。"
    },
    {
     "en": "He [[doesn't]] ((drink)) tea.",
     "zh": "他不喝茶。"
    },
    {
     "en": "The build [[doesn't]] ((fail)) on my Mac.",
     "zh": "在我的 Mac 上构建不会失败。"
    }
   ],
   "wrong": {
    "bad": "He doesn't drink~~s~~ tea.",
    "good": "He [[doesn't]] ((drink)) tea."
   },
   "be": "be 动词直接加 not：I[['m not]] · he [[isn't]] · they [[aren't]]"
  },
  "question": {
   "title": "疑问句", "short": "疑问",
   "formula": [
    "Do / Does",
    "主语",
    "动词原形",
    "其他？"
   ],
   "rule": "把 do 或 does 放到最前面，动词用原形。回答时也用 do / does。",
   "examples": [
    {
     "en": "[[Do]] you ((work)) <<at weekends>>?",
     "zh": "你周末上班吗？",
     "answer": "Yes, I [[do]]. / No, I [[don't]]."
    },
    {
     "en": "[[Does]] she ((work)) <<at weekends>>?",
     "zh": "她周末上班吗？",
     "answer": "Yes, she [[does]]. / No, she [[doesn't]]."
    },
    {
     "en": "What time [[does]] the meeting ((start))?",
     "zh": "会议几点开始？",
     "answer": "It [[start{s}]] at ten."
    }
   ],
   "notes": [
    "问「谁」做这件事时，不用 do / does：Who [[work{s}]] here?（谁在这里工作？）",
    "be 动词把 be 提到前面：[[Are]] you busy? · [[Is]] he at home?"
   ]
  },
