 "markup": {
  "[[x]]": "重点形式：这个语法要你注意的词（橙底）",
  "{x}": "变化的部分：只用在 [[ ]] 里，例如 work{s}（橙底里加粗下划线）",
  "((x))": "变回原形的动词（虚线下划线）",
  "<<x>>": "信号词（圆角框）",
  "~~x~~": "错句里错的部分（删除线）"
 },
 "sections": {
  "idea": {
   "title": "一句话说清",
   "short": "说清",
   "text": "一般过去时说的是**「已经过去、做完了」**的事：昨天、上周、三年前……时间已经翻篇了。动词要变成**过去式**。",
   "uses": [
    {
     "zh": "过去某个时候做完的一件事",
     "en": "I [[fixed]] the bug <<yesterday>>.",
     "en_zh": "我昨天把那个 bug 修好了。"
    },
    {
     "zh": "过去一件接一件发生的事",
     "en": "She [[opened]] the app, [[tapped]] Save and [[waited]].",
     "en_zh": "她打开 App，点了保存，然后等着。"
    },
    {
     "zh": "过去的状态，现在已经结束",
     "en": "I [[lived]] in Manchester <<for two years>>.",
     "en_zh": "我在曼彻斯特住过两年。"
    }
   ],
   "signals": [
    "yesterday",
    "last night",
    "last week",
    "two days ago",
    "in 2020",
    "when I was a child",
    "just now"
   ]
  },
  "positive": {
   "title": "肯定句",
   "short": "肯定",
   "formula": [
    "主语",
    "动词过去式",
    "其他"
   ],
   "rule": "大多数动词后面加 ed，有些动词长得不一样（go → went），要单独记。好消息：**不管谁做的，形式都一样。**",
   "examples": [
    {
     "en": "I [[work{ed}]] late <<last night>>.",
     "zh": "我昨晚加班到很晚。"
    },
    {
     "en": "The tests [[pass{ed}]] <<this morning>>.",
     "zh": "今天上午测试都通过了。"
    },
    {
     "en": "We [[went]] to Brighton <<at the weekend>>.",
     "zh": "我们周末去了布莱顿。"
    }
   ],
   "be": "be 动词有两个过去式：I / he / she / it [[was]] · you / we / they [[were]]"
  },
  "negative": {
   "title": "否定句",
   "short": "否定",
   "formula": [
    "主语",
    "didn't",
    "动词原形",
    "其他"
   ],
   "rule": "所有人都用 didn't。**「过去」只能出现一次**：didn't 已经是过去了，后面的动词要变回原形。",
   "examples": [
    {
     "en": "I [[didn't]] ((see)) your message.",
     "zh": "我没看到你的消息。"
    },
    {
     "en": "The update [[didn't]] ((fix)) the crash.",
     "zh": "这次更新没修好崩溃。"
    },
    {
     "en": "We [[didn't]] ((go)) out <<last night>>.",
     "zh": "我们昨晚没出去。"
    }
   ],
   "wrong": {
    "bad": "She didn't ~~called~~ me.",
    "good": "She [[didn't]] ((call)) me."
   },
   "be": "be 动词直接加 not：I [[wasn't]] there · they [[weren't]] ready"
  },
  "question": {
   "title": "疑问句",
   "short": "疑问",
   "formula": [
    "Did",
    "主语",
    "动词原形",
    "其他？"
   ],
   "rule": "把 did 放到最前面，动词用原形。回答也用 did / didn't。",
   "examples": [
    {
     "en": "[[Did]] you ((watch)) the match <<last night>>?",
     "zh": "你昨晚看比赛了吗？",
     "answer": "Yes, I [[did]]. / No, I [[didn't]]."
    },
    {
     "en": "[[Did]] the build ((pass))?",
     "zh": "构建通过了吗？",
     "answer": "Yes, it [[did]]. / No, it [[didn't]]."
    },
    {
     "en": "When [[did]] you ((join)) the team?",
     "zh": "你什么时候加入团队的？",
     "answer": "I [[join{ed}]] <<in 2022>>."
    }
   ],
   "notes": [
    "问「谁」做了这件事时，不用 did：Who [[broke]] the build?（谁把构建搞坏了？）",
    "be 动词把 was / were 提到前面：[[Were]] you at the meeting? · [[Was]] it expensive?"
   ]
  },
