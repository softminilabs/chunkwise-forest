  "spelling": {
   "title": "怎么加 ed、怎么读",
   "short": "加 ed",
   "rules": [
    {
     "ending": "大多数动词",
     "change": "直接加 ed",
     "examples": [
      "work → [[work{ed}]]",
      "fix → [[fix{ed}]]"
     ]
    },
    {
     "ending": "e 结尾",
     "change": "只加 d",
     "examples": [
      "like → [[like{d}]]",
      "use → [[use{d}]]"
     ]
    },
    {
     "ending": "辅音字母 + y 结尾",
     "change": "去 y，加 ied",
     "examples": [
      "tr~~y~~ → [[tr{ied}]]",
      "cop~~y~~ → [[cop{ied}]]"
     ]
    },
    {
     "ending": "元音字母 + y 结尾",
     "change": "直接加 ed",
     "examples": [
      "play → [[play{ed}]]",
      "stay → [[stay{ed}]]"
     ]
    },
    {
     "ending": "短词，一个元音字母 + 一个辅音字母结尾",
     "change": "双写最后一个字母，再加 ed",
     "examples": [
      "stop → [[stop{ped}]]",
      "plan → [[plan{ned}]]"
     ]
    },
    {
     "ending": "一个元音字母 + l 结尾（英式拼法）",
     "change": "双写 l，再加 ed",
     "examples": [
      "travel → [[travel{led}]]",
      "cancel → [[cancel{led}]]"
     ]
    }
   ],
   "sound": [
    {
     "say": "/t/",
     "when": "在 p、k、s、sh、ch、f 这类不震动喉咙的音后面",
     "examples": [
      "[[work{ed}]]",
      "[[stop{ped}]]",
      "[[fix{ed}]]"
     ]
    },
    {
     "say": "/d/",
     "when": "在震动喉咙的音和元音后面",
     "examples": [
      "[[play{ed}]]",
      "[[call{ed}]]",
      "[[tr{ied}]]"
     ]
    },
    {
     "say": "/ɪd/",
     "when": "在 t 和 d 后面，要多读出一个音节",
     "examples": [
      "[[want{ed}]]",
      "[[need{ed}]]",
      "[[test{ed}]]"
     ]
    }
   ],
   "oddSounds": "只有 t、d 结尾的才多读一个 /ɪd/。worked 是一个音节，不要读成 work-ed。"
  },
  "irregular": {
   "title": "不规则动词",
   "short": "不规则",
   "text": "最常用的动词偏偏不加 ed，只能背。按长相分成几组，记起来轻松一点。",
   "rules": [
    {
     "ending": "过去式和原形一样",
     "change": "不用变",
     "examples": [
      "put → [[put]]",
      "cut → [[cut]]",
      "let → [[let]]"
     ]
    },
    {
     "ending": "变成 ought / aught",
     "change": "都读 /ɔːt/",
     "examples": [
      "buy → [[bought]]",
      "think → [[thought]]",
      "teach → [[taught]]"
     ]
    },
    {
     "ending": "中间的元音变了",
     "change": "换个元音",
     "examples": [
      "get → [[got]]",
      "write → [[wrote]]",
      "take → [[took]]",
      "come → [[came]]"
     ]
    },
    {
     "ending": "d 结尾变成 t",
     "change": "把 d 换成 t",
     "examples": [
      "send → [[sent]]",
      "spend → [[spent]]",
      "build → [[built]]"
     ]
    },
    {
     "ending": "完全不一样",
     "change": "单独记",
     "examples": [
      "go → [[went]]",
      "have → [[had]]",
      "do → [[did]]",
      "be → [[was / were]]"
     ]
    }
   ],
   "tip": "read 的过去式还是 read，但读音变成 /red/，跟颜色 red 一样。"
  },
  "contrast": {
   "title": "和其他时态比一比",
   "short": "比一比",
   "pairs": [
    {
     "with": "现在完成时",
     "this": {
      "meaning": "说了「什么时候」，事情已经翻篇",
      "en": "I [[lost]] my keys <<yesterday>>."
     },
     "that": {
      "meaning": "不说什么时候，重点是现在的结果",
      "en": "I[['ve lost]] my keys."
     }
    },
    {
     "with": "过去进行时",
     "this": {
      "meaning": "一件完整的事，做完了",
      "en": "I [[called]] you <<at 8>>."
     },
     "that": {
      "meaning": "那一刻正在做，还没做完",
      "en": "I [[was cooking]] <<at 8>>."
     }
    }
   ],
   "commonMistakes": [
    {
     "bad": "Did you ~~saw~~ my message?",
     "good": "[[Did]] you ((see)) my message?",
     "why": "did 已经是过去了，动词用原形。"
    },
    {
     "bad": "I didn't ~~went~~ to the party.",
     "good": "I [[didn't]] ((go)) to the party.",
     "why": "「过去」只能出现一次。"
    },
    {
     "bad": "I ~~have seen~~ him yesterday.",
     "good": "I [[saw]] him <<yesterday>>.",
     "why": "有 yesterday 这类过去时间，用一般过去时。"
    },
    {
     "bad": "She ~~goed~~ home early.",
     "good": "She [[went]] home early.",
     "why": "go 是不规则动词：went。"
    },
    {
     "bad": "We ~~was~~ late for the meeting.",
     "good": "We [[were]] late for the meeting.",
     "why": "we 用 were。"
    }
   ]
  }
 },
