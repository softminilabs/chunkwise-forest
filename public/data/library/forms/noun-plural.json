{
 "id": "forms-noun-plural",
 "title": "名词单复数",
 "module": "词形变化",
 "idea": "一个用单数，两个以上用复数。大多数加 s；少数要改拼写或整个变样；还有一些**根本不能数**，不加 s，也不用 a / an。",
 "rules": [
  {
   "rule": "大多数",
   "change": "加 s",
   "examples": [
    [
     "bug",
     "bugs"
    ],
    [
     "phone",
     "phones"
    ],
    [
     "user",
     "users"
    ]
   ]
  },
  {
   "rule": "s、x、sh、ch、z 结尾",
   "change": "加 es",
   "examples": [
    [
     "box",
     "boxes"
    ],
    [
     "bus",
     "buses"
    ],
    [
     "match",
     "matches"
    ],
    [
     "quiz",
     "quizzes"
    ]
   ],
   "note": "quiz 要双写 z"
  },
  {
   "rule": "辅音 + y",
   "change": "去 y，加 ies",
   "examples": [
    [
     "city",
     "cities"
    ],
    [
     "story",
     "stories"
    ],
    [
     "company",
     "companies"
    ],
    [
     "library",
     "libraries"
    ]
   ]
  },
  {
   "rule": "元音 + y",
   "change": "直接加 s",
   "examples": [
    [
     "day",
     "days"
    ],
    [
     "key",
     "keys"
    ],
    [
     "boy",
     "boys"
    ]
   ]
  },
  {
   "rule": "f / fe 结尾",
   "change": "去 f / fe，加 ves",
   "examples": [
    [
     "life",
     "lives"
    ],
    [
     "knife",
     "knives"
    ],
    [
     "leaf",
     "leaves"
    ],
    [
     "half",
     "halves"
    ],
    [
     "shelf",
     "shelves"
    ]
   ],
   "except": [
    [
     "roof",
     "roofs"
    ],
    [
     "chef",
     "chefs"
    ],
    [
     "chief",
     "chiefs"
    ],
    [
     "belief",
     "beliefs"
    ],
    [
     "safe",
     "safes"
    ]
   ]
  },
  {
   "rule": "o 结尾",
   "change": "多数加 s，少数加 es",
   "examples": [
    [
     "photo",
     "photos"
    ],
    [
     "video",
     "videos"
    ],
    [
     "piano",
     "pianos"
    ],
    [
     "memo",
     "memos"
    ]
   ],
   "except": [
    [
     "potato",
     "potatoes"
    ],
    [
     "tomato",
     "tomatoes"
    ],
    [
     "hero",
     "heroes"
    ],
    [
     "echo",
     "echoes"
    ]
   ],
   "note": "加 es 的就这几个常见的，记住它们，其余加 s"
  }
 ],
 "sound": [
  {
   "say": "/s/",
   "when": "在 p、t、k、f 这类不震动喉咙的音后面",
   "examples": [
    "laptops",
    "cats",
    "books"
   ]
  },
  {
   "say": "/z/",
   "when": "在震动喉咙的音和元音后面",
   "examples": [
    "bugs",
    "phones",
    "days"
   ]
  },
  {
   "say": "/ɪz/",
   "when": "在 s、z、sh、ch、ge 这类「嘶嘶」的音后面",
   "examples": [
    "buses",
    "matches",
    "pages"
   ]
  }
 ],
