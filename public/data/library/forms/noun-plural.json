 "agreement": [
  {
   "rule": "news、information、advice 这些不可数名词，动词用单数",
   "en": "The news [[is]] good."
  },
  {
   "rule": "everyone、everybody、each、every 后面用单数",
   "en": "Everyone [[is]] here. · Each of the bugs [[needs]] a test."
  },
  {
   "rule": "a number of + 复数名词 → 复数；the number of + 复数名词 → 单数",
   "en": "A number of users [[are]] waiting. · The number of users [[is]] growing."
  },
  {
   "rule": "时间、钱、距离当一个整体说时用单数",
   "en": "Two hours [[is]] a long time."
  },
  {
   "rule": "team、company、staff：美式多用单数，英式单复数都常见",
   "en": "The team [[is]] ready.（美）· The team [[are]] ready.（英）"
  },
  {
   "rule": "data：日常和技术写作里多当不可数用单数，学术写作也有人用复数",
   "en": "The data [[is]] stored locally."
  }
 ],
 "commonMistakes": [
  {
   "bad": "informations",
   "good": "information",
   "why": "information 不可数，不加 s"
