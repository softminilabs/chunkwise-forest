  },
  {
   "bad": "codes（指程序代码）",
   "good": "code / lines of code",
   "why": "代码当不可数；codes 是「密码、编码」"
  },
  {
   "bad": "a news",
   "good": "a piece of news / some news",
   "why": "news 不可数，而且是单数"
  },
  {
   "bad": "equipments",
   "good": "equipment",
