   "example": "I'm [[at]] work until six."
  },
  {
   "id": "p-surface",
   "kind": "地点",
   "prep": "on",
   "rule": "在表面上、在线上用 on",
   "items": [
    "the table",
    "the wall",
    "the screen",
    "the second floor",
    "the bus",
    "the train"
   ],
   "example": "The error message is [[on]] the screen."
  },
  {
   "id": "p-inside",
   "kind": "地点",
   "prep": "in",
   "rule": "在里面、在一个范围内用 in（房间、城市、国家、车里）",
   "items": [
