{
 "id": "ref-prepositions-in-on-at",
 "title": "介词 in / on / at",
 "idea": "at 是「点」，on 是「面、线、具体的一天」，in 是「里面、一段时间」。时间和地点都按这个想。",
 "categories": [
  {
   "id": "t-clock",
   "kind": "时间",
   "prep": "at",
   "rule": "具体的钟点、时刻用 at",
   "items": [
    "7 o'clock",
    "9:30",
    "noon",
    "midnight",
    "lunchtime",
    "the end of the day"
   ],
   "example": "The stand-up starts [[at]] 9:30."
  },
  {
   "id": "t-day",
   "kind": "时间",
   "prep": "on",
   "rule": "具体的某一天用 on（星期几、日期、某天的上午）",
   "items": [
    "Monday",
    "Friday morning",
    "December 8th",
    "my birthday",
    "New Year's Day",
    "the first day"
   ],
   "example": "Let's ship it [[on]] Friday.",
   "note": "in the morning，但 on Friday morning：说到具体哪一天就用 on"
  },
  {
   "id": "t-long",
   "kind": "时间",
   "prep": "in",
   "rule": "一段较长的时间用 in（月、年、季节、世纪、上午下午晚上）",
   "items": [
    "May",
    "2026",
    "the summer",
    "the morning",
    "the evening",
    "the 1990s"
   ],
   "example": "We launched the app [[in]] 2026."
  },
  {
   "id": "t-night",
   "kind": "时间",
   "prep": "at",
   "rule": "几个固定说法用 at",
   "items": [
    "night",
    "the weekend",
    "Christmas",
    "the moment",
    "the same time"
   ],
   "example": "I usually read [[at]] night.",
   "accept": {
    "the weekend": [
     "at",
     "on"
    ]
   },
   "note": "the weekend：英式 at，美式 on，两个都算对"
  },
  {
   "id": "t-within",
   "kind": "时间",
   "prep": "in",
   "rule": "「多久以后」用 in",
   "items": [
    "two days",
    "ten minutes",
    "a week",
    "an hour"
   ],
   "example": "I'll get back to you [[in]] ten minutes."
  },
  {
