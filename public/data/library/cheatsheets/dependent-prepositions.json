  "mistakes": {
   "title": "最常见的错",
   "short": "易错",
   "text": "中国人最容易错的两类：**不该加介词的加了**（discuss、mention、contact 直接跟宾语），**该加的漏了**（listen to、reply to）。",
   "commonMistakes": [
    {
     "bad": "Let's discuss ~~about~~ the design.",
     "good": "Let's [[discuss]] the design.",
     "why": "discuss 后面直接跟事情。talk about 才要 about。"
    },
    {
     "bad": "He mentioned ~~about~~ the deadline.",
     "good": "He [[mentioned]] the deadline.",
     "why": "mention 直接跟宾语，不加 about。"
    },
    {
     "bad": "I'll contact ~~with~~ the client.",
     "good": "I'll [[contact]] the client.",
     "why": "contact 直接跟人。"
    },
    {
     "bad": "Can you join ~~to~~ the call?",
     "good": "Can you [[join]] the call?",
     "why": "join 直接跟会议、团队。"
    },
    {
     "bad": "We need to emphasise ~~on~~ security.",
     "good": "We need to [[emphasise]] security.",
     "why": "动词 emphasise 不加 on；名词才说 put emphasis on。"
    },
    {
     "bad": "It depends ~~of~~ the budget.",
     "good": "It [[depends on]] the budget.",
     "why": "depend 只跟 on。"
    },
    {
     "bad": "She's good ~~in~~ maths.",
     "good": "She's [[good at]] maths.",
     "why": "擅长用 good at。"
    },
    {
     "bad": "I'm interested ~~about~~ AI.",
     "good": "I'm [[interested in]] AI.",
     "why": "interested 只跟 in。"
    },
    {
     "bad": "He didn't reply ~~me~~.",
     "good": "He didn't [[reply to]] me.",
     "why": "reply 后面要加 to 才能跟人。"
    },
    {
     "bad": "Please listen ~~me~~.",
     "good": "Please [[listen to]] me.",
     "why": "listen 后面要加 to。"
    },
    {
     "bad": "Please explain ~~me~~ the issue.",
     "good": "Please [[explain]] the issue [[to me]].",
     "why": "explain 不能直接跟人，要说 explain something to someone。"
    },
    {
     "bad": "We arrived ~~to~~ the office late.",
     "good": "We [[arrived at]] the office late.",
     "why": "arrive 用 at（地点）或 in（城市、国家），不用 to。"
    }
   ],
   "tip": "直接跟宾语、**不加介词**的动词：discuss, mention, contact, join, attend, enter, approach, answer, emphasise, marry。"
  }
 },
